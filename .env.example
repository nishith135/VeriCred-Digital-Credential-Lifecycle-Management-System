# Application Environment: development, testing, production
APP_ENV=development
DEBUG=true
SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_12345

# Database URLs
# Async engine for FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/credential_db
# Synchronous engine for Alembic migrations and CLI synthetic generator
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/credential_db
# Isolated Test Database URLs for pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/credential_test_db
TEST_DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/credential_test_db

# Synthetic Data Configuration
DEFAULT_SEED=42
SYNTHETIC_LEARNER_COUNT=20000
SYNTHETIC_COURSE_COUNT=1000
SYNTHETIC_CREDENTIAL_COUNT=10000
SYNTHETIC_VERIFICATION_COUNT=5000
